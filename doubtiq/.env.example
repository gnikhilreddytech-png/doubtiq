# DoubtIQ — PostgreSQL/Supabase environment template.
#
# Copy this file to `.env` and fill in your real Supabase connection string.
# NEVER commit `.env` (it is already git-ignored) and never print it.
#
#   cp .env.example .env   → edit .env
#
# The PostgreSQL database/schema/data ALREADY exist on Supabase — the app
# only ever connects; it never creates, migrates or seeds it at runtime.

DATABASE_URL=postgres://postgres.<project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional — set in production so canonical URLs and the sitemap use your
# real domain instead of localhost.
# SITE_URL=https://doubtiq.example.com

# Optional — set to 1 behind an HTTPS proxy so login cookies are Secure.
# COOKIE_SECURE=1
# TRUST_PROXY=1
